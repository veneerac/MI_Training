{
  "info": {
    "_postman_id": "543fc057-4d37-46ff-8427-0881b825103f",
    "name": "Hospital Backend (direct, port 9090)",
    "description": "Calls the Hospital back-end service (Hospital-Service-JDK11-2.0.0.jar) directly, without MI.\nStart it first: java -jar Hospital-Service-JDK11-2.0.0.jar (listens on 9090).\nRun '1. Reserve' before '2. Fee' and '3. Payment': the reserve call saves {{appointmentNumber}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "backendUrl",
      "value": "http://localhost:9090"
    },
    {
      "key": "appointmentNumber",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Reserve an appointment",
      "item": [
        {
          "name": "Grand Oak - surgery (thomas collins)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{backendUrl}}/grandoaks/categories/surgery/reserve",
              "host": [
                "{{backendUrl}}"
              ],
              "path": [
                "grandoaks",
                "categories",
                "surgery",
                "reserve"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": {\n    \"name\": \"John Doe\",\n    \"dob\": \"1940-03-19\",\n    \"ssn\": \"234-23-525\",\n    \"address\": \"California\",\n    \"phone\": \"8770586755\",\n    \"email\": \"johndoe@gmail.com\"\n  },\n  \"doctor\": \"thomas collins\",\n  \"hospital_id\": \"grandoaks\",\n  \"hospital\": \"grand oak community hospital\",\n  \"appointment_date\": \"2025-04-02\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('appointmentNumber', pm.response.json().appointmentNumber);"
                ]
              }
            }
          ]
        },
